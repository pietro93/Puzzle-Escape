{
  "packagerConfig": {
    "asar": true,
    "icon": "./assets/icon",
    "name": "Riddle Escape",
    "executableName": "riddle-escape",
    "appBundleId": "com.yourdomain.riddleescape",
    "ignore": [
      "^[\\\\/]?(app|components|data|docs|hooks|lib|public|styles|types|utils|electron|android|ios|steam|rules)([\\\\/]|$)",
      "^[\\\\/]?\\.(continue|github|git|claude|playwright-mcp|next)([\\\\/]|$)",
      "^[\\\\/]?(next\\.config\\.mjs|next-env\\.d\\.ts|tsconfig(\\.tsbuildinfo)?|tsconfig\\.json|tailwind\\.config\\.ts|postcss\\.config\\.mjs|components\\.json|capacitor\\.config\\.ts|pnpm-lock\\.yaml|package-lock\\.json|\\.gitignore)$",
      "^[\\\\/]?(EXTERNAL_DEPENDENCIES_DOWNLOAD_LIST|EXTERNAL_URL_UPDATE_SUMMARY|MISSING_IMAGES_REPORT|@INDEX|privacy-policy|terms-of-service)\\.(md)$",
      "^[\\\\/]?(level5-step\\d+|splash1|step\\d+)\\.png$"
    ]
  },
  "outDir": "out-forge",
  "rebuildConfig": {},
  "makers": [
    {
      "name": "@electron-forge/maker-squirrel",
      "config": {
        "name": "riddle_escape",
        "authors": "Your Name",
        "description": "A mysterious puzzle game where you solve riddles to escape",
        "iconUrl": "https://yourdomain.com/icon.ico",
        "setupIcon": "./assets/icon.ico"
      }
    },
    {
      "name": "@electron-forge/maker-zip",
      "platforms": ["darwin"]
    },
    {
      "name": "@electron-forge/maker-deb",
      "config": {
        "options": {
          "icon": "./assets/icon.png",
          "categories": ["Game"],
          "description": "A mysterious puzzle game where you solve riddles to escape"
        }
      }
    },
    {
      "name": "@electron-forge/maker-rpm",
      "config": {}
    }
  ]
}
